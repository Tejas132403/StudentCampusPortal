   ═══════════════════════════════════════════════════════════════════ *@

@model StudentCampusPortal.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Settings";
    ViewData["ActivePage"] = "Settings";
    Layout = "_Layout";
}

<div class="page-title">Settings</div>
<div class="page-sub">Manage your account preferences</div>

<!-- User info card -->
<div class="card-panel mb-4" style="max-width:480px;">
    <div class="d-flex align-items-center gap-3 mb-1">
        <div class="user-avatar" style="width:48px;height:48px;font-size:1.3rem;">
            <i class="bi bi-person-fill"></i>
        </div>
        <div>
            <div style="font-weight:700;">@Context.Session.GetString("StudentName")</div>
            <div style="font-size:0.78rem;color:#888;">Class: @Context.Session.GetString("Class") &nbsp;·&nbsp; Batch: @Context.Session.GetString("Batch")</div>
        </div>
    </div>
</div>

<!-- Change Password -->
<div class="card-panel mb-4" style="max-width:480px;">
    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-lock-fill" style="color:var(--accent)"></i>
        <strong>Change Password</strong>
    </div>

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3" style="font-size:0.82rem;"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label fw-semibold" style="font-size:0.85rem;"></label>
            <input asp-for="CurrentPassword" class="form-control" />
            <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:0.8rem;"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-semibold" style="font-size:0.85rem;"></label>
            <input asp-for="NewPassword" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger" style="font-size:0.8rem;"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold" style="font-size:0.85rem;"></label>
            <input asp-for="ConfirmNewPassword" class="form-control" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger" style="font-size:0.8rem;"></span>
        </div>
        <button type="submit" class="btn btn-primary">Update Password</button>
    </form>
</div>

<!-- Logout -->
<div class="card-panel" style="max-width:480px;">
    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-box-arrow-right" style="color:#e53935"></i>
        <strong>Logout</strong>
    </div>
    <p style="font-size:0.85rem;color:#888;">Sign out from your account on this device.</p>
    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
